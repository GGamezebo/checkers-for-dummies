{
	"App": {
		"scene": { "id": "app_root", "async_loading": false, "on_event": "ev.open_menu" },
		"states": {
			"Menu": {
				"scene": { "id": "menu", "loading_screen": false },
				"enter": ["ev.open_menu"],
				"leave": ["ev.start_game"]
			},
			"Battle": {
				"scene": { "id": "game", "loading_screen": false },
				"enter": ["ev.start_game"],
				"leave": ["ev.open_post_battle", "ev.start_game"]
			},
			"PostBattle": {
				"scene": { "id": "post_battle", "on_event": "ev.open_post_battle" },
				"enter": ["ev.exit_game"],
				"leave": ["ev.open_menu", "ev.start_game"]
			}
		}
	}
}
